# Names only, no values. Copy to .env.local and fill in. All variables are optional:
# without the Sanity ones the site builds and renders from local fallback content.

# Canonical origin of the marketing site (no trailing slash). Default: https://applyspace.app
NEXT_PUBLIC_SITE_URL=
# Origin of the app (login and onboarding). Default: same origin as the site (applyspace.app serves the site to visitors who are not signed in).
NEXT_PUBLIC_APP_URL=

# Sanity (public identifiers, safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=

# Sanity read token: only for a private dataset or draft preview. Server only. Leave empty for a public dataset.
SANITY_API_READ_TOKEN=
# Shared secret checked by POST /api/revalidate (Sanity webhook). Server only.
SANITY_REVALIDATE_SECRET=

# Set by Vercel (do not define): VERCEL_ENV decides whether the site may be indexed (production only).
