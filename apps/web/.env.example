# Supabase (Project Settings > API). Both values are public by design:
# access is limited by Row Level Security, not by hiding the key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Place autocomplete (Geoapify). Server-side only, never NEXT_PUBLIC.
GEOAPIFY_API_KEY=

# PostHog browser analytics (Project Settings > Project Details)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Resume parser with Claude (optional, OFF by default: without these the parser
# uses built-in rules and no resume text leaves the server). Server-side only.
# RESUME_LLM_ENABLED=1
# ANTHROPIC_API_KEY=
# RESUME_LLM_MODEL=
# Demo account (docs/demo-account.md). Names only: the founder sets the values in Vercel
# (Preview environment only, never Production) and in .env.local for local runs. Never commit them.
# DEMO_USER_EMAIL=demo@example.com             must be on example.com
# DEMO_USER_PASSWORD=                          12+ characters, used by the seed script and /auth/demo
# DEMO_LOGIN_ENABLED=1                         turns on /auth/demo (previews and local runs only)
# DEMO_LOGIN_KEY=                              24+ random characters, the ?key= of /auth/demo
# SUPABASE_SERVICE_ROLE_KEY=                   seed script only, on the founder's computer; never in Vercel

# Public website (served on applyspace.app to signed-out visitors, see src/lib/site-routing.ts).
# All optional: without Sanity the website renders local fallback content.
# NEXT_PUBLIC_SITE_URL=                        canonical origin, default https://applyspace.app
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=
# NEXT_PUBLIC_SANITY_API_VERSION=
# SANITY_API_READ_TOKEN=                       server only, private dataset or drafts
# SANITY_REVALIDATE_SECRET=                    server only, checked by POST /api/revalidate (Sanity webhook)
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=            macOS download (.dmg or release page); empty sends "Download for macOS" to /login
# VERCEL_ENV is set by Vercel: only production is indexable.
